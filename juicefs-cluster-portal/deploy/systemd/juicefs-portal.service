[Unit]
Description=JuiceFS read-only cluster portal
After=network-online.target juicefs-prometheus.service
Wants=network-online.target

[Service]
Type=simple
User=jfsportal
Group=jfsportal
EnvironmentFile=/etc/juicefs-portal/portal.env
ExecStart=/opt/juicefs-portal/bin/juicefs-portal
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

CPUQuota=50%
MemoryAccounting=true
MemoryMax=1G
IOAccounting=true
IOWeight=10
TasksMax=128
LimitNOFILE=65536
Nice=10

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.20.1.152/32
IPAddressAllow=10.20.1.157/32
ReadOnlyPaths=/opt/juicefs-portal /etc/juicefs-portal
ReadWritePaths=/var/lib/juicefs-portal/portal

[Install]
WantedBy=multi-user.target
