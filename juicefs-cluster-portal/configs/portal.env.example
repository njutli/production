# Local fixture mode only. Production secrets must not be committed.
PORTAL_ADDR=127.0.0.1:8080
PORTAL_MODE=fixture
PORTAL_FIXTURES_DIR=../fixtures
PORTAL_WEB_DIR=../web
PORTAL_PROMETHEUS_URL=http://127.0.0.1:9090
PORTAL_NAMESPACE_DB=/var/lib/juicefs-portal/portal/namespace.db
PORTAL_ADMIN_TOKEN=replace-with-admin-secret
PORTAL_USER_TOKEN=replace-with-disabled-user-secret
PORTAL_USERS_FILE=/etc/juicefs-portal/users.json
PORTAL_SESSION_SECRET_FILE=/etc/juicefs-portal/session-secret
PORTAL_SESSION_TTL=8h
PORTAL_SECURE_COOKIES=true
PORTAL_TLS_ADDR=10.20.1.152:8443
PORTAL_TLS_CERT_FILE=/etc/juicefs-portal/tls.crt
PORTAL_TLS_KEY_FILE=/etc/juicefs-portal/tls.key
