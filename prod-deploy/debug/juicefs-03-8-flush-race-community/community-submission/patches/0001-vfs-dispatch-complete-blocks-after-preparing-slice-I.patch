From d0497f3ceb3d57873b42ac4b1c515712abb1e0ce Mon Sep 17 00:00:00 2001
From: Li Lingfeng <a1151488180@gmail.com>
Date: Wed, 19 Aug 2026 17:43:06 +0800
Subject: [PATCH 1/3] vfs: dispatch complete blocks after preparing slice ID

The first write to a new slice can fill a complete block before the
asynchronously allocated slice ID is ready. In that case the write path
skips FlushTo because the ID is still zero, and the ID-ready path does not
revisit the missed dispatch.

After assigning the ID, dispatch complete blocks for a non-frozen slice.
Record a FlushTo failure as EIO so it remains observable by later flushes.

On v1.3.x this bug causes a ~3.4x randwrite throughput collapse (560.9 vs
1917.0 MiB/s with 256 KiB block size) due to data retention triggering
buffer throttle self-lock. Backporting this fix to 1.3.x resolves the
collapse; on main the missed dispatch is absorbed by other drainage paths
but the code path is still incorrect.

Assisted-by: DeepSeek <deepseek-v4-pro>
Signed-off-by: Li Lingfeng <a1151488180@gmail.com>
---
 pkg/vfs/writer.go | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/pkg/vfs/writer.go b/pkg/vfs/writer.go
index 91297fa..ed432cc 100644
--- a/pkg/vfs/writer.go
+++ b/pkg/vfs/writer.go
@@ -94,6 +94,13 @@ func (s *sliceWriter) prepareID(ctx meta.Context, retry bool) {
 	}
 	if s.writer != nil && s.writer.ID() == 0 {
 		s.writer.SetID(s.id)
+		if s.id > 0 && !s.freezed && int(s.slen) >= f.w.blockSize {
+			if err := s.writer.FlushTo(int(s.slen)); err != nil {
+				logger.Warnf("flush inode: %v chunk: %d after preparing slice ID: %s",
+					s.chunk.file.inode, s.id, err)
+				s.err = syscall.EIO
+			}
+		}
 	}
 	f.Unlock()
 }
