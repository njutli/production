+func TestRangeFlushErrorAndCancellation(t *testing.T) {
+	t.Run("stored-error", func(t *testing.T) {
+		f := rangeTestFile()
+		f.w = &dataWriter{
+			conf:       &Config{Chunk: &chunk.Config{}},
+			maxRetries: 0,
+		}
+		f.writecond = utils.NewCond(f)
+		f.err = syscall.EIO
+		if got := f.flushRange(meta.Background(), 0, 1); got != syscall.EIO {
+			t.Fatalf("flushRange error=%s, want EIO", got)
+		}
+	})
+
+	t.Run("canceled-wait", func(t *testing.T) {
+		f := rangeTestFile(0)
+		f.w = &dataWriter{
+			conf:       &Config{Chunk: &chunk.Config{PutTimeout: 0}},
+			maxRetries: 0,
+		}
+		f.writecond = utils.NewCond(f)
+		s := rangeTestSlice(f.chunks[0])
+		s.freezed = true // keep it pending without invoking storage
+		ctx := meta.NewContext(1, 1, nil)
+		ctx.Cancel()
+		started := time.Now()
+		if got := f.flushRange(ctx, 0, 1); got != syscall.EINTR {
+			t.Fatalf("canceled flushRange error=%s, want EINTR", got)
+		}
+		if elapsed := time.Since(started); elapsed < 2*time.Second || elapsed > 5*time.Second {
+			t.Fatalf("canceled flushRange elapsed=%s, want one normal 3s wait", elapsed)
+		}
+	})
