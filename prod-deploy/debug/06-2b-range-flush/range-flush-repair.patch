+func TestRangeFlushMultiHandleOverlapCrossChunkAndEOF(t *testing.T) {
+	v, _ := createTestVFS(nil, "")
+	ctx := NewLogContext(meta.Background())
+	fe, fh1, errno := v.Create(ctx, 1, "range-api", 0644, 0, syscall.O_RDWR)
+	if errno != 0 {
+		t.Fatalf("create: %s", errno)
+	}
+	defer v.Release(ctx, fe.Inode, fh1)
+	_, fh2, errno := v.Open(ctx, fe.Inode, syscall.O_RDWR)
+	if errno != 0 {
+		t.Fatalf("open second handle: %s", errno)
+	}
+	defer v.Release(ctx, fe.Inode, fh2)
+
+	off := uint64(meta.ChunkSize - 128<<10)
+	want := bytes.Repeat([]byte{0x7b}, 256<<10)
+	if errno := v.Write(ctx, fe.Inode, want, off, fh1); errno != 0 {
+		t.Fatalf("cross-chunk write: %s", errno)
+	}
+	got := make([]byte, len(want))
+	if n, errno := v.Read(ctx, fe.Inode, got, off, fh2); errno != 0 || n != len(got) || !bytes.Equal(got, want) {
+		t.Fatalf("multi-handle read errno=%s n=%d equal=%v", errno, n, bytes.Equal(got, want))
+	}
+	partial := make([]byte, 32<<10)
+	if n, errno := v.Read(ctx, fe.Inode, partial, off+17<<10, fh2); errno != 0 || n != len(partial) || !bytes.Equal(partial, want[17<<10:49<<10]) {
+		t.Fatalf("overlap read errno=%s n=%d equal=%v", errno, n, bytes.Equal(partial, want[17<<10:49<<10]))
+	}
+	eof := make([]byte, 4096)
+	if n, errno := v.Read(ctx, fe.Inode, eof, off+uint64(len(want)), fh2); errno != 0 || n != 0 {
+		t.Fatalf("EOF read errno=%s n=%d, want success/0", errno, n)
+	}
+}
