+func TestRangeFlushRealWritePathDependenciesAndReadback(t *testing.T) {
+	v, _ := createTestVFS(nil, "")
+	ctx := NewLogContext(meta.Background())
+	fe, fh, errno := v.Create(ctx, 1, "range-growth", 0644, 0, syscall.O_RDWR)
+	if errno != 0 {
+		t.Fatalf("create: %s", errno)
+	}
+	defer v.Release(ctx, fe.Inode, fh)
+
+	want := bytes.Repeat([]byte{0x5a}, 256<<10)
+	for i := uint64(0); i < 3; i++ {
+		if errno := v.Write(ctx, fe.Inode, want, i*meta.ChunkSize, fh); errno != 0 {
+			t.Fatalf("growth write chunk %d: %s", i, errno)
+		}
+	}
+
+	dw := v.writer.(*dataWriter)
+	f := dw.find(fe.Inode)
+	if f == nil {
+		t.Fatal("live file writer missing")
+	}
+	f.Lock()
+	if len(f.chunks) != 3 || len(f.chunks[1].slices) == 0 || len(f.chunks[2].slices) == 0 {
+		f.Unlock()
+		t.Fatalf("unexpected live chunk graph: %d chunks", len(f.chunks))
+	}
+	s1 := f.chunks[1].slices[0]
+	s2 := f.chunks[2].slices[0]
+	if s1.dep == nil || s2.dep != s1 {
+		f.Unlock()
+		t.Fatal("real growth writes did not create the expected cross-chunk dependency chain")
+	}
+	f.Unlock()
+
+	if errno := dw.FlushRange(ctx, fe.Inode, 2*meta.ChunkSize, uint64(len(want))); errno != 0 {
+		t.Fatalf("range flush: %s", errno)
+	}
+	got := make([]byte, len(want))
+	if n, errno := v.Read(ctx, fe.Inode, got, 2*meta.ChunkSize, fh); errno != 0 || n != len(got) || !bytes.Equal(got, want) {
+		t.Fatalf("growth readback errno=%s n=%d equal=%v", errno, n, bytes.Equal(got, want))
+	}
+
+	// Once the file length already covers the write, a fixed-size overwrite
+	// must not invent a growth dependency.
+	if errno := v.Write(ctx, fe.Inode, bytes.Repeat([]byte{0x33}, 256<<10), meta.ChunkSize+1<<20, fh); errno != 0 {
+		t.Fatalf("fixed overwrite: %s", errno)
+	}
+	f.Lock()
+	for _, s := range f.chunks[1].slices {
+		if s.dep != nil {
+			f.Unlock()
+			t.Fatal("fixed-size overwrite unexpectedly acquired dependency")
+		}
+	}
+	f.Unlock()
+}
