+func TestRangeFlushFixedOverwriteCommitNotification(t *testing.T) {
+	f := rangeTestFile(0)
+	s := rangeTestSlice(f.chunks[0])
+	ready := make(chan struct{})
+	done := make(chan bool, 1)
+	go func() { done <- waitForRangeTestCommit(f, s, ready, 2*time.Second) }()
+	<-ready
+
+	// Acquiring the same lock proves WaitWithTimeout captured the condition
+	// channel and released the lock.  Completion therefore cannot win a race
+	// by happening before waiter registration.
+	f.Lock()
+	f.markCommitted(s)
+	f.Unlock()
+	select {
+	case ok := <-done:
+		if !ok {
+			t.Fatal("non-growing overwrite waiter returned via timeout")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("non-growing overwrite commit did not wake range waiter")
+	}
+}
+
+func TestRangeFlushCommitNotificationRaces(t *testing.T) {
+	t.Run("commit-before-waiter", func(t *testing.T) {
+		f := rangeTestFile(0)
+		s := rangeTestSlice(f.chunks[0])
+		f.Lock()
+		f.markCommitted(s)
+		f.Unlock()
+		if !waitForRangeTestCommit(f, s, nil, time.Second) {
+			t.Fatal("already committed slice waited")
+		}
+	})
+
+	t.Run("multiple-waiters", func(t *testing.T) {
+		f := rangeTestFile(0)
+		s := rangeTestSlice(f.chunks[0])
+		const n = 4
+		ready := make([]chan struct{}, n)
+		done := make(chan bool, n)
+		for i := range ready {
+			ready[i] = make(chan struct{})
+			go func(ch chan struct{}) { done <- waitForRangeTestCommit(f, s, ch, 2*time.Second) }(ready[i])
+		}
+		for _, ch := range ready {
+			<-ch
+		}
+		f.Lock()
+		f.markCommitted(s)
+		f.Unlock()
+		for i := 0; i < n; i++ {
+			if !<-done {
+				t.Fatalf("waiter %d timed out", i)
+			}
+		}
+	})
+
+	t.Run("spurious-wake-does-not-complete", func(t *testing.T) {
+		f := rangeTestFile(0)
+		s := rangeTestSlice(f.chunks[0])
+		ready := make(chan struct{})
+		done := make(chan bool, 1)
+		go func() { done <- waitForRangeTestCommit(f, s, ready, 2*time.Second) }()
+		<-ready
+		f.Lock()
+		f.commitcond.Broadcast()
+		f.Unlock()
+		select {
+		case <-done:
+			t.Fatal("spurious wake bypassed committed predicate")
+		case <-time.After(25 * time.Millisecond):
+		}
+		f.Lock()
+		f.markCommitted(s)
+		f.Unlock()
+		if !<-done {
+			t.Fatal("waiter timed out after real commit")
+		}
+	})
+
+	t.Run("timeout-is-not-success", func(t *testing.T) {
+		f := rangeTestFile(0)
+		s := rangeTestSlice(f.chunks[0])
+		if waitForRangeTestCommit(f, s, nil, 10*time.Millisecond) {
+			t.Fatal("timeout reported commit success")
+		}
+	})
+}
