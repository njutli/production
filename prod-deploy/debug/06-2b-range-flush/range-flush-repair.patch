+// flushRange freezes and waits only for the selected chunks and the FIFO
+// prefixes of their live dependencies.  Full Flush/Close/fsync/Truncate and
+// copy_file_range semantics continue to use the original whole-inode path.
+func (f *fileWriter) flushRange(ctx meta.Context, off, size uint64) syscall.Errno {
+	start := time.Now()
+	f.Lock()
+	defer f.Unlock()
+	f.flushwaiting++
+
+	var err syscall.Errno
+	wait := time.Second * time.Duration((f.w.maxRetries+2)*(f.w.maxRetries+2)/2)
+	if wait < time.Minute*5 {
+		wait = time.Minute * 5
+	}
+	deadline := time.Now().Add(wait)
+	targets, _ := f.rangeScope(off, size)
+	for rangePending(targets) && err == 0 {
+		for s := range targets {
+			if !s.freezed {
+				s.freezed = true
+				go s.flushData()
+			}
+		}
+		if f.commitcond.WaitWithTimeout(time.Second*3) && ctx.Canceled() && time.Since(start) > f.w.conf.Chunk.PutTimeout*2 {
+			err = syscall.EINTR
+			break
+		}
+		if time.Now().After(deadline) {
+			err = syscall.EIO
+			break
+		}
+	}
+	f.flushwaiting--
+	if f.flushwaiting == 0 && f.writewaiting > 0 {
+		f.writecond.Broadcast()
+	}
+	if err == 0 {
+		err = f.err
+	}
+	return err
+}
