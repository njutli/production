+func TestRangeScopeDependencyClosureAndCommittedExclusion(t *testing.T) {
+	t.Run("live-multilevel-prefix", func(t *testing.T) {
+		f := rangeTestFile(0, 1, 2, 3)
+		a := rangeTestSlice(f.chunks[0])
+		prefix := rangeTestSlice(f.chunks[0])
+		tail := rangeTestSlice(f.chunks[0])
+		b := rangeTestSlice(f.chunks[1])
+		c := rangeTestSlice(f.chunks[2])
+		unrelated := rangeTestSlice(f.chunks[3])
+		b.dep = prefix
+		c.dep = b
+		prefix.dep = a
+
+		targets, fallback := f.rangeScope(2*meta.ChunkSize, 1)
+		if fallback {
+			t.Fatal("valid dependency chain used full fallback")
+		}
+		for name, s := range map[string]*sliceWriter{"a": a, "prefix": prefix, "b": b, "c": c} {
+			if _, ok := targets[s]; !ok {
+				t.Fatalf("dependency closure omitted %s", name)
+			}
+		}
+		for name, s := range map[string]*sliceWriter{"tail": tail, "unrelated": unrelated} {
+			if _, ok := targets[s]; ok {
+				t.Fatalf("dependency closure included %s", name)
+			}
+		}
+	})
+
+	t.Run("committed-dependency-removed-from-queue", func(t *testing.T) {
+		f := rangeTestFile(0, 1)
+		committed := &sliceWriter{chunk: f.chunks[0], committed: true}
+		later := rangeTestSlice(f.chunks[0])
+		target := rangeTestSlice(f.chunks[1])
+		target.dep = committed
+
+		targets, fallback := f.rangeScope(meta.ChunkSize, 1)
+		if fallback {
+			t.Fatal("committed dependency triggered full fallback")
+		}
+		if _, ok := targets[target]; !ok {
+			t.Fatal("primary target omitted")
+		}
+		if _, ok := targets[later]; ok {
+			t.Fatal("later unrelated slice from committed dependency chunk selected")
+		}
+	})
+
+	t.Run("missing-live-dependency-falls-back", func(t *testing.T) {
+		f := rangeTestFile(0, 1, 2)
+		missing := &sliceWriter{chunk: f.chunks[0]}
+		rangeTestSlice(f.chunks[0])
+		target := rangeTestSlice(f.chunks[1])
+		other := rangeTestSlice(f.chunks[2])
+		target.dep = missing
+		targets, fallback := f.rangeScope(meta.ChunkSize, 1)
+		if !fallback {
+			t.Fatal("missing uncommitted dependency did not trigger safe fallback")
+		}
+		if _, ok := targets[other]; !ok {
+			t.Fatal("safe fallback did not include every live slice")
+		}
+	})
+}
