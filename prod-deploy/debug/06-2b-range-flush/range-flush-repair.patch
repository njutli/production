+func rangeTestFile(indices ...uint32) *fileWriter {
+	f := &fileWriter{chunks: make(map[uint32]*chunkWriter)}
+	f.commitcond = utils.NewCond(f)
+	for _, index := range indices {
+		f.chunks[index] = &chunkWriter{indx: index, file: f}
+	}
+	return f
+}
+
+func rangeTestSlice(c *chunkWriter) *sliceWriter {
+	s := &sliceWriter{chunk: c}
+	c.slices = append(c.slices, s)
+	return s
+}
+
+// waitForRangeTestCommit mirrors the predicate loop used by flushRange while
+// allowing deterministic notification tests without storage or timing hooks.
+func waitForRangeTestCommit(f *fileWriter, s *sliceWriter, ready chan<- struct{}, timeout time.Duration) bool {
+	f.Lock()
+	defer f.Unlock()
+	if ready != nil {
+		close(ready)
+	}
+	for !s.committed {
+		if f.commitcond.WaitWithTimeout(timeout) {
+			return false
+		}
+	}
+	return true
+}
