+// markCommitted publishes completion to every waiter.  Dependency waiters
+// historically only needed notifications for growing slices, but range flush
+// also waits for fixed-size overwrite slices.  The caller must hold f.Mutex.
+func (f *fileWriter) markCommitted(s *sliceWriter) {
+	s.committed = true
+	f.commitcond.Broadcast()
