+func TestRangeScopeChunkBoundaryAndNoDependency(t *testing.T) {
+	f := rangeTestFile(0, 1, 2)
+	a := rangeTestSlice(f.chunks[0])
+	b := rangeTestSlice(f.chunks[1])
+	c := rangeTestSlice(f.chunks[2])
+	targets, fallback := f.rangeScope(meta.ChunkSize-1, 2)
+	if fallback || len(targets) != 2 {
+		t.Fatalf("boundary scope fallback=%v targets=%d, want false/2", fallback, len(targets))
+	}
+	if _, ok := targets[a]; !ok {
+		t.Fatal("chunk 0 omitted")
+	}
+	if _, ok := targets[b]; !ok {
+		t.Fatal("chunk 1 omitted")
+	}
+	if _, ok := targets[c]; ok {
+		t.Fatal("unrelated chunk 2 selected")
+	}
+}
