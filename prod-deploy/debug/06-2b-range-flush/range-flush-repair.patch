+// rangeScope returns the live slices in chunks intersecting [off, off+size),
+// plus the FIFO prefixes required by their uncommitted dependencies.  The
+// caller must hold f.Mutex.  If an uncommitted dependency cannot be found in
+// its live chunk queue, it conservatively falls back to all live slices.
+func (f *fileWriter) rangeScope(off, size uint64) (map[*sliceWriter]struct{}, bool) {
+	targets := make(map[*sliceWriter]struct{})
+	if size == 0 || off+size < off {
+		return targets, false
+	}
+	end := off + size
+	first := uint32(off / meta.ChunkSize)
+	last := uint32((end - 1) / meta.ChunkSize)
+	for indx, c := range f.chunks {
+		if indx < first || indx > last {
+			continue
+		}
+		for _, s := range c.slices {
+			targets[s] = struct{}{}
+		}
+	}
+
+	changed := true
+	for changed {
+		changed = false
+		for s := range targets {
+			dep := s.dep
+			if dep == nil || dep.committed {
+				continue
+			}
+			if dep.chunk == nil {
+				return f.allLiveSlices(), true
+			}
+			found := false
+			for _, prefix := range dep.chunk.slices {
+				if _, ok := targets[prefix]; !ok {
+					targets[prefix] = struct{}{}
+					changed = true
+				}
+				if prefix == dep {
+					found = true
+					break
+				}
+			}
+			if !found {
+				return f.allLiveSlices(), true
+			}
+		}
+	}
+	return targets, false
+}
+
+// allLiveSlices is the safe fallback for an invariant violation in the
+// dependency graph.  The caller must hold f.Mutex.
+func (f *fileWriter) allLiveSlices() map[*sliceWriter]struct{} {
+	targets := make(map[*sliceWriter]struct{})
+	for _, c := range f.chunks {
+		for _, s := range c.slices {
+			targets[s] = struct{}{}
+		}
+	}
+	return targets
+}
+
+func rangePending(targets map[*sliceWriter]struct{}) bool {
+	for s := range targets {
+		if !s.committed {
+			return true
+		}
+	}
+	return false
+}
