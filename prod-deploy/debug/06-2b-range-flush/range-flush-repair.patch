+func TestRangePendingRequiresEveryTarget(t *testing.T) {
+	a := &sliceWriter{committed: true}
+	b := &sliceWriter{}
+	targets := map[*sliceWriter]struct{}{a: {}, b: {}}
+	if !rangePending(targets) {
+		t.Fatal("uncommitted target was ignored")
+	}
+	b.committed = true
+	if rangePending(targets) {
+		t.Fatal("all committed targets still reported pending")
+	}
+}
