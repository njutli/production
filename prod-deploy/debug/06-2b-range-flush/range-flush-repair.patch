+func TestRangeScopeZeroAndOverflow(t *testing.T) {
+	f := rangeTestFile(0)
+	rangeTestSlice(f.chunks[0])
+	for name, tc := range map[string]struct{ off, size uint64 }{
+		"zero":     {off: 0, size: 0},
+		"overflow": {off: ^uint64(0) - 1, size: 4},
+	} {
+		targets, fallback := f.rangeScope(tc.off, tc.size)
+		if fallback || len(targets) != 0 {
+			t.Fatalf("%s scope fallback=%v targets=%d, want false/0", name, fallback, len(targets))
+		}
+	}
+}
