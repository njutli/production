+type eagerFreezeTestWriter struct {
+	mu       sync.Mutex
+	id       uint64
+	finished chan int
+	flushed  []int
+}
+
+func (w *eagerFreezeTestWriter) WriteAt(p []byte, off int64) (int, error) { return len(p), nil }
+func (w *eagerFreezeTestWriter) ID() uint64                               { return w.id }
+func (w *eagerFreezeTestWriter) SetID(id uint64)                          { w.id = id }
+func (w *eagerFreezeTestWriter) SetWriteback(bool)                        {}
+func (w *eagerFreezeTestWriter) Abort()                                   {}
+func (w *eagerFreezeTestWriter) Finish(length int) error {
+	w.finished <- length
+	return nil
+}
+func (w *eagerFreezeTestWriter) FlushTo(offset int) error {
+	w.mu.Lock()
+	w.flushed = append(w.flushed, offset)
+	w.mu.Unlock()
+	return nil
+}
+
+func eagerFreezeTestSliceAt(enabled bool, chunkIndex, sliceOffset uint32, blockSize int) (*fileWriter, *sliceWriter, *eagerFreezeTestWriter) {
+	f := &fileWriter{w: &dataWriter{blockSize: blockSize, eagerFreeze: enabled}, length: 1 << 30}
+	c := &chunkWriter{indx: chunkIndex, file: f}
+	w := &eagerFreezeTestWriter{id: 1, finished: make(chan int, 1)}
+	s := &sliceWriter{
+		id:      1,
+		chunk:   c,
+		off:     sliceOffset,
+		writer:  w,
+		notify:  utils.NewCond(&f.Mutex),
+		started: time.Now(),
+	}
+	c.slices = []*sliceWriter{s}
+	f.chunks = map[uint32]*chunkWriter{chunkIndex: c}
+	return f, s, w
+}
+
+func eagerFreezeTestSlice(enabled bool, logicalOffset uint32) (*fileWriter, *sliceWriter, *eagerFreezeTestWriter) {
+	return eagerFreezeTestSliceAt(enabled, 0, logicalOffset, 256<<10)
+}
+
+func TestExperimentalEagerFreezeCompleteAlignedBlock(t *testing.T) {
+	f, s, w := eagerFreezeTestSlice(true, 0)
+	f.Lock()
+	st := f.writeChunk(meta.Background(), 0, 0, make([]byte, 256<<10))
+	f.Unlock()
+	if st != 0 || !s.freezed {
+		t.Fatalf("expected immediate freeze, status=%v frozen=%v", st, s.freezed)
+	}
+	select {
+	case got := <-w.finished:
+		if got != 256<<10 {
+			t.Fatalf("Finish length=%d", got)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for Finish")
+	}
+}
+
+func TestExperimentalEagerFreezeUsesGlobalAlignmentAcrossChunk(t *testing.T) {
+	const blockSize = 3 << 20
+	f, s, _ := eagerFreezeTestSliceAt(true, 1, 0, blockSize)
+	f.Lock()
+	st := f.writeChunk(meta.Background(), 1, 0, make([]byte, blockSize))
+	f.Unlock()
+	if st != 0 || s.freezed {
+		t.Fatalf("chunk-relative alignment must not trigger, status=%v frozen=%v", st, s.freezed)
+	}
+
+	// Chunk 1 starts at 64 MiB; adding 2 MiB makes the global offset
+	// divisible by the deliberately non-divisor 3 MiB block size.
+	f, s, w := eagerFreezeTestSliceAt(true, 1, 2<<20, blockSize)
+	f.Lock()
+	st = f.writeChunk(meta.Background(), 1, 2<<20, make([]byte, blockSize))
+	f.Unlock()
+	if st != 0 || !s.freezed {
+		t.Fatalf("globally aligned block did not freeze, status=%v frozen=%v", st, s.freezed)
+	}
+	select {
+	case got := <-w.finished:
+		if got != blockSize {
+			t.Fatalf("Finish length=%d", got)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for globally aligned Finish")
+	}
+}
+
+func TestExperimentalEagerFreezeVFSKnownContent(t *testing.T) {
+	v, _ := createTestVFS(nil, "")
+	v.writer.(*dataWriter).eagerFreeze = true
+	ctx := NewLogContext(meta.Background())
+	entry, fh, st := v.Create(ctx, 1, "eager-freeze", 0644, 0, syscall.O_RDWR)
+	if st != 0 {
+		t.Fatalf("create: %s", st)
+	}
+	blockSize := v.Conf.Chunk.BlockSize
+	if st = v.Fallocate(ctx, entry.Inode, 0, 0, int64(blockSize), fh); st != 0 {
+		t.Fatalf("fallocate: %s", st)
+	}
+	want := make([]byte, blockSize)
+	for i := range want {
+		want[i] = byte(i*31 + 7)
+	}
+	if st = v.Write(ctx, entry.Inode, want, 0, fh); st != 0 {
+		t.Fatalf("write: %s", st)
+	}
+	deadline := time.Now().Add(time.Second)
+	for {
+		f := v.writer.(*dataWriter).find(entry.Inode)
+		pending := 0
+		if f != nil {
+			f.Lock()
+			pending = len(f.chunks)
+			f.Unlock()
+		}
+		if pending == 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("eager write was not committed before any read or explicit flush")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	got := make([]byte, blockSize)
+	n, st := v.Read(ctx, entry.Inode, got, 0, fh)
+	if st != 0 || n != blockSize {
+		t.Fatalf("read: status=%s bytes=%d", st, n)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatal("read-back content mismatch")
+	}
+	if st = v.Flush(ctx, entry.Inode, fh, 0); st != 0 {
+		t.Fatalf("flush: %s", st)
+	}
+}
+
+func TestExperimentalEagerFreezeDefaultOff(t *testing.T) {
+	f, s, w := eagerFreezeTestSlice(false, 0)
+	f.Lock()
+	st := f.writeChunk(meta.Background(), 0, 0, make([]byte, 256<<10))
+	f.Unlock()
+	if st != 0 || s.freezed {
+		t.Fatalf("default path changed, status=%v frozen=%v", st, s.freezed)
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if len(w.flushed) != 1 || w.flushed[0] != 256<<10 {
+		t.Fatalf("expected existing FlushTo path, got %v", w.flushed)
+	}
+}
+
+func TestExperimentalEagerFreezeRejectsMisalignedOrPartial(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		offset  uint32
+		size    int
+		growing bool
+	}{
+		{name: "misaligned", offset: 1, size: 256 << 10},
+		{name: "partial", offset: 0, size: 128 << 10},
+		{name: "growing", offset: 0, size: 256 << 10, growing: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f, s, _ := eagerFreezeTestSlice(true, tc.offset)
+			if tc.growing {
+				f.length = 0
+			}
+			f.Lock()
+			st := f.writeChunk(meta.Background(), 0, tc.offset, make([]byte, tc.size))
+			f.Unlock()
+			if st != 0 || s.freezed {
+				t.Fatalf("unexpected freeze, status=%v frozen=%v", st, s.freezed)
+			}
+		})
+	}
+}
