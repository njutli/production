diff --git a/pkg/vfs/vfs.go b/pkg/vfs/vfs.go
--- a/pkg/vfs/vfs.go
+++ b/pkg/vfs/vfs.go
@@ -7,6 +7,7 @@
 	"sort"
 	"sync"
+	"sync/atomic"
 	"syscall"
 	"time"
 
@@ -158,6 +159,8 @@
 	Buckets: prometheus.LinearBuckets(4096, 4096, 32),
 )
 
+var writeInstrCounter int64
+
 var (
 	readSizeHistogram = prometheus.NewHistogram(prometheus.HistogramOpts{
@@ -832,6 +835,8 @@
 		return
 	}
 
+	wlockStart := time.Now()
 	if !h.Wlock(ctx) {
 		err = syscall.EINTR
 		return
 	}
+	wlockDur := time.Since(wlockStart)
 	defer h.Wunlock()
 
