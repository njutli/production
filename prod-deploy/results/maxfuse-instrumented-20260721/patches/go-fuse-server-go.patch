+// Instrumentation for write latency breakdown
+var (
+	writeOpCount     int64
+	writeHandlerNs   int64
+	writeResponseNs  int64
+	writeTotalNs     int64
+	lastWriteLogTime time.Time
+)
+
+func logWriteStats() {
+	now := time.Now()
+	if now.Sub(lastWriteLogTime) < time.Second {
+		return
+	}
+	lastWriteLogTime = now
+	n := atomic.LoadInt64(&writeOpCount)
+	if n == 0 {
+		return
+	}
+	handler := atomic.LoadInt64(&writeHandlerNs) / n / 1e6
+	response := atomic.LoadInt64(&writeResponseNs) / n / 1e6
+	total := atomic.LoadInt64(&writeTotalNs) / n / 1e6
+	readWait := total - handler - response
+	fmt.Fprintf(os.Stderr, "[write-stats] count=%d avg_total=%dms handler=%dms response=%dms read_wait=%dms\n",
+		n, total, handler, response, readWait)
+}
+
