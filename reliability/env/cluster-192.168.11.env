# shellcheck shell=bash
# Long-term reliability profile for client 192.168.11.12 and storage nodes
# 192.168.11.11/13/14. Source this file before invoking an LT case.
LT_CONFIG_PROFILE=slow-validation-192
LT_EXPECTED_MAX_READ=131072
LT_MOUNT_POINT=/mnt/juicefs
LT_JFS=/tmp/juicefs-1.4.1-patched
LT_EXPECTED_JFS_MD5=24fae0852051c80ca571cb2f20275d46
LT_META=tikv://192.168.11.11:2379,192.168.11.13:2379,192.168.11.14:2379/juicefs-prod
LT_EXPECTED_VOLUME_UUID=3e54dcc4-991e-425a-8e76-16c9c1fb6836
LT_METRICS_URL=http://127.0.0.1:9567/metrics

LT_CEPH_CONF=/etc/ceph/ceph.conf
LT_CEPH_KEYRING=/etc/ceph/ceph.client.admin.keyring
LT_CEPH_READONLY_WRAPPER=/home/turboai/production/reliability/lib/ceph-readonly-sudo.sh
LT_CEPH_POOL=juicefs-data
LT_OSD_IDS=0,2,3,4,5,6
LT_EXPECTED_OSD_COUNT=6

LT_RESULT_MOUNT=/data
LT_EXPECTED_RESULT_DEVICE=/dev/sdb
LT_MIN_RESULT_FREE_GIB=20
LT_MIN_CEPH_MAX_AVAIL_TIB=0.4
LT_MIN_OSD_DB_FREE_GIB=4

LT_STORAGE_NODES=192.168.11.11,192.168.11.13,192.168.11.14
LT_STORAGE_SSH_USER=turboai
LT_STORAGE_IOSTAT_DEVICES=sdb
